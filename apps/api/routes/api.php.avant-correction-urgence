<?php

declare(strict_types=1);

use App\Http\Controllers\Api\V1\Admin\ModerationAdminController;
use App\Http\Controllers\Api\V1\Admin\OrderAdminController;
use App\Http\Controllers\Api\V1\Admin\QuestAdminController;
use App\Http\Controllers\Api\V1\Admin\StudentAdminController;
use App\Http\Controllers\Api\V1\Admin\XpRuleAdminController;
use App\Http\Controllers\Api\V1\AdminController;
use App\Http\Controllers\Api\V1\AuthController;
use App\Http\Controllers\Api\V1\BadgeController;
use App\Http\Controllers\Api\V1\ChallengeController;
use App\Http\Controllers\Api\V1\DashboardController;
use App\Http\Controllers\Api\V1\ForgeController;
use App\Http\Controllers\Api\V1\LeaderboardController;
use App\Http\Controllers\Api\V1\LedgerController;
use App\Http\Controllers\Api\V1\LearningPathController;
use App\Http\Controllers\Api\V1\LevelController;
use App\Http\Controllers\Api\V1\MeController;
use App\Http\Controllers\Api\V1\MissionController;
use App\Http\Controllers\Api\V1\OrderController;
use App\Http\Controllers\Api\V1\QuestController;
use App\Http\Controllers\Api\V1\RewardController;
use App\Http\Controllers\Api\V1\SubmissionController;
use App\Http\Controllers\Api\V1\TrackController;
use App\Http\Middleware\ForceJsonResponse;
use Illuminate\Support\Facades\Route;

/*
|--------------------------------------------------------------------------
| Routes API - Code212 Quest (v1)
|--------------------------------------------------------------------------
|
| Prefixe applicatif : /api  (configure dans bootstrap/app.php)
| Prefixe de version  : /v1
|
| Reponses normalisees : { "data": ..., "meta": ... }
| Erreurs normalisees  : { "message": "...", "errors": { ... } }
|
*/

Route::prefix('v1')->middleware([ForceJsonResponse::class])->group(function (): void {

    /*
    |----------------------------------------------------------------------
    | Authentification (routes publiques)
    |----------------------------------------------------------------------
    */
    Route::prefix('auth')->middleware('throttle:api-auth')->group(function (): void {
        Route::post('login', [AuthController::class, 'login'])->name('api.v1.auth.login');
        Route::post('uca/callback', [AuthController::class, 'ucaCallback'])->name('api.v1.auth.uca');
    });

    /*
    |----------------------------------------------------------------------
    | Routes authentifiees
    |----------------------------------------------------------------------
    */
    Route::middleware(['auth:sanctum', 'throttle:api'])->group(function (): void {

        // --- Session -------------------------------------------------------
        Route::prefix('auth')->group(function (): void {
            Route::post('logout', [AuthController::class, 'logout'])->abilities('write');
            Route::get('me', [AuthController::class, 'me']);
        });

        // --- Profil et preferences -----------------------------------------
        Route::get('me', [MeController::class, 'show']);
        Route::patch('me', [MeController::class, 'update'])->abilities('write');
        Route::post('me/pseudonym', [MeController::class, 'pseudonym'])->abilities('write');
        Route::get('me/preferences', [MeController::class, 'preferences']);
        Route::put('me/preferences', [MeController::class, 'updatePreferences'])->abilities('write');

        // --- Tableau de bord -------------------------------------------------
        Route::get('dashboard', [DashboardController::class, 'index']);

        // --- Quetes ----------------------------------------------------------
        Route::get('quests', [QuestController::class, 'index']);
        Route::post('quests', [QuestController::class, 'store'])->abilities('write');
        Route::get('quests/{quest}', [QuestController::class, 'show']);
        Route::post('quests/{quest}/enroll', [QuestController::class, 'enroll'])->abilities('write');
        Route::post('quests/{quest}/steps/{step}/submit', [QuestController::class, 'submitStep'])->abilities('write');

        // --- Productions a faire valider -------------------------------------
        Route::get('submissions', [SubmissionController::class, 'index']);
        Route::post('submissions/{submission}/approve', [SubmissionController::class, 'approve'])->abilities('write');

        // --- XP, classement, boutique ----------------------------------------
        Route::get('ledger', [LedgerController::class, 'index']);
        Route::get('leaderboards', [LeaderboardController::class, 'index']);
        Route::get('rewards', [RewardController::class, 'index']);
        Route::post('rewards/{reward}/purchase', [RewardController::class, 'purchase'])->abilities('write');
        Route::get('orders', [OrderController::class, 'index']);
        Route::patch('orders/{order}/approve', [OrderController::class, 'approve'])->abilities('write');
        Route::patch('orders/{order}/reject', [OrderController::class, 'reject'])->abilities('write');

        // --- Badges -----------------------------------------------------------
        Route::get('badges', [BadgeController::class, 'index']);
        Route::get('badges/{code}', [BadgeController::class, 'show']);

        // --- Voies et niveaux --------------------------------------------------
        Route::get('tracks', [TrackController::class, 'index']);
        Route::get('levels', [LevelController::class, 'index']);

        // --- Parcours -----------------------------------------------------------
        Route::get('paths', [LearningPathController::class, 'index']);
        Route::get('paths/{path}', [LearningPathController::class, 'show']);

        // --- Missions ------------------------------------------------------------
        Route::get('missions', [MissionController::class, 'index']);
        Route::post('missions/{mission}/claim', [MissionController::class, 'claim'])->abilities('write');

        // --- Challenges ----------------------------------------------------------
        Route::get('challenges', [ChallengeController::class, 'index']);
        Route::post('challenges/{challenge}/join', [ChallengeController::class, 'join'])->abilities('write');
        Route::post('challenges/{challenge}/submissions', [ChallengeController::class, 'submissions'])->abilities('write');

        // --- La Forge -------------------------------------------------------------
        Route::prefix('forge')->group(function (): void {
            Route::get('categories', [ForgeController::class, 'categories']);
            Route::get('threads', [ForgeController::class, 'threads']);
            Route::post('threads', [ForgeController::class, 'storeThread'])->abilities('write');
            Route::get('threads/{thread}', [ForgeController::class, 'thread']);
            Route::post('threads/{thread}/replies', [ForgeController::class, 'storeReply'])->abilities('write');
            Route::post('threads/{thread}/report', [ForgeController::class, 'report'])->abilities('write');
            Route::post('solutions/{solution}/accept', [ForgeController::class, 'acceptSolution'])->abilities('write');
        });

        // --- Administration ------------------------------------------------------
        Route::prefix('admin')->middleware('role:admin,moderator')->group(function (): void {
            Route::get('analytics', [AdminController::class, 'analytics']);

            Route::get('quests', [QuestAdminController::class, 'index']);
            Route::post('quests', [QuestAdminController::class, 'store'])->abilities('write');
            Route::patch('quests/{quest}', [QuestAdminController::class, 'update'])->abilities('write');

            Route::get('students', [StudentAdminController::class, 'index']);
            Route::patch('students/{student}', [StudentAdminController::class, 'update'])->abilities('write');

            Route::get('rules/xp', [XpRuleAdminController::class, 'index']);
            Route::put('rules/xp', [XpRuleAdminController::class, 'update'])->abilities('write');

            Route::get('moderation/reports', [ModerationAdminController::class, 'reports']);
            Route::post('moderation/reports/{report}/resolve', [ModerationAdminController::class, 'resolve'])->abilities('write');
            Route::get('moderation/audit', [ModerationAdminController::class, 'audit']);

            Route::get('orders', [OrderAdminController::class, 'index']);
        });
    });
});
