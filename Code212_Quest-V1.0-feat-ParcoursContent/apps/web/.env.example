# --- API Laravel -----------------------------------------------------------
# Mode démo (données locales simulées, aucun backend requis) : true
VITE_USE_MOCK=true
# URL de l'API Laravel (préfixe /api/v1), à renseigner au branchement du backend
VITE_API_BASE_URL=/api/v1
# Cible du proxy Vite en développement (utilisé quand VITE_API_BASE_URL est relatif)
VITE_API_PROXY=http://localhost:8000
