# ---------------------------------------------------------------------------
# Code212 Quest - API Laravel
# Copier ce fichier vers .env : cp .env.example .env
# ---------------------------------------------------------------------------

APP_NAME="Code212 Quest API"
APP_ENV=local
APP_KEY=base64:YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Casablanca
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de donnees (PostgreSQL) -------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=code212_quest
DB_USERNAME=code212
DB_PASSWORD=secret

# --- Cache / file d'attente / Redis -----------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Sanctum (jetons API) ----------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173
SANCTUM_TOKEN_PREFIX=api_
SANCTUM_EXPIRATION=43200

# --- CORS (front React/TS) --------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_SUPPORTS_CREDENTIALS=true

# --- SSO UCA / OIDC ----------------------------------------------------------
UCA_OIDC_ENABLED=false
UCA_OIDC_ISSUER=https://sso.uca.ma/realms/uca
UCA_OIDC_CLIENT_ID=code212-quest
UCA_OIDC_CLIENT_SECRET=
UCA_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/uca/callback
UCA_OIDC_SCOPES="openid profile email matricule filiere promotion"

# --- API Libki (presence / reservations) ------------------------------------
LIBKI_API_ENABLED=false
LIBKI_API_BASE_URL=https://api.libki.example.ma
LIBKI_API_TOKEN=
LIBKI_WEBHOOK_SECRET=
LIBKI_CHECKIN_XP=15
LIBKI_CHECKOUT_XP=5

# --- Identifiants de demonstration (seeders) ---------------------------------
SEED_ADMIN_EMAIL=admin@code212.ma
SEED_ADMIN_PASSWORD=ChangeMe!2024
SEED_DEMO_EMAILS=amina.bouzid@uca.ma,youssef.elamine@uca.ma,salma.nadir@uca.ma
